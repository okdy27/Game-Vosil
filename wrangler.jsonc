{
  "name": "game-vosil",
  "main": "server/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "vosil-game", "database_id": "121a78d5-1c12-41df-801f-275c5b7071de" }
  ],
  "durable_objects": { "bindings": [ { "name": "ARENA", "class_name": "Arena" } ] },
  "migrations": [ { "tag": "v1-arena", "new_sqlite_classes": ["Arena"] } ],
  "triggers": { "crons": ["*/5 5-6 * * *"] },
  "vars": {
    "CHAIN_ID": "480",
    "TOKEN_ADDRESS": "0x37187dbEBC6778EA23ba9d37eB0Aac8990504544",
    "GAME_WALLET_ADDRESS": "0x7703A56b4C5269af23df1EB485C754274E36916B",
    "PAYOUT_ENABLED": "1",
    "PT_PER_VOS": "1000",
    "EARN_CAP_DAY": "1000",
    "EARN_PTS_PER_MIN": "30",
    "REDEEM_MIN": "5000",
    "REDEEM_MAX_DAY": "5000",
    "REVIEW_MIN_HOURS": "24",
    "REVIEW_MAX_HOURS": "48",
    "QUARTER_BUDGET_VOS": "30185",
    "DAILY_QUOTA_VOS": "335",
    "MAX_WALLETS_PER_IP_DAY": "5",
    "MAX_WALLETS_PER_DEVICE": "2",
    "PAYOUT_BATCH": "5",
    "ARENA_ENABLED": "0",
    "TURNSTILE_SITEKEY": ""
  }
}
